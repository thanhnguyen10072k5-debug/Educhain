@model Educhain.Models.Grade
@{
    Layout = null;
    ViewData["Title"] = "Nhập điểm mới";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Nhập điểm sinh viên | EduChain</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #0f172a; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }
        .card { background: white; padding: 36px; border-radius: 16px; width: 100%; max-width: 520px; }
        h2 { margin-bottom: 20px; color: #1e293b; font-size: 20px; }
        .form-group { margin-bottom: 16px; }
        label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #475569; }
        input, select, textarea { width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none; }
        input:focus, select:focus, textarea:focus { border-color: #2586ff; }
        .btn-group { display: flex; gap: 10px; margin-top: 25px; }
        .btn { padding: 11px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none; cursor: pointer; border: none; }
        .btn-primary { background: #2586ff; color: white; flex: 1; }
        .btn-secondary { background: #e2e8f0; color: #475569; }
        .text-danger { color: #ef4444; font-size: 12px; margin-top: 4px; display: block; }
    </style>
</head>
<body>
    <div class="card">
        <h2>📝 Nhập bảng điểm sinh viên</h2>
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label>Chọn sinh viên (*)</label>
                <select asp-for="StudentId" asp-items="ViewBag.Students" required>
                    <option value="">-- Chọn sinh viên --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Chọn môn học (*)</label>
                <select asp-for="SubjectId" asp-items="ViewBag.Subjects" required>
                    <option value="">-- Chọn môn học --</option>
                </select>
                <span asp-validation-for="SubjectId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Điểm số (0.0 - 10.0) (*)</label>
                <input asp-for="Score" type="number" step="0.1" min="0" max="10" placeholder="Ví dụ: 8.5" required />
                <span asp-validation-for="Score" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Học kỳ</label>
                <input asp-for="Semester" value="Học kỳ 1 (2026 - 2027)" />
            </div>

            <div class="form-group">
                <label>Ghi chú</label>
                <textarea asp-for="Note" rows="2" placeholder="Ghi chú thêm..."></textarea>
            </div>

            <div class="btn-group">
                <a href="/Grade/Index" class="btn btn-secondary">Hủy</a>
                <button type="submit" class="btn btn-primary">Lưu bảng điểm</button>
            </div>
        </form>
    </div>
</body>
</html>
@model Educhain.Models.Student
@{
    Layout = null;
    ViewData["Title"] = "Thêm sinh viên mới";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Thêm sinh viên mới | EduChain</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #0f172a; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px; }
        .card { background: white; padding: 36px; border-radius: 16px; width: 100%; max-width: 550px; }
        h2 { margin-bottom: 20px; color: #1e293b; font-size: 20px; }
        .form-group { margin-bottom: 16px; }
        label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #475569; }
        input { width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none; }
        input:focus { border-color: #2586ff; }
        .btn-group { display: flex; gap: 10px; margin-top: 25px; }
        .btn { padding: 11px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none; cursor: pointer; border: none; }
        .btn-primary { background: #2586ff; color: white; flex: 1; }
        .btn-secondary { background: #e2e8f0; color: #475569; }
        .text-danger { color: #ef4444; font-size: 12px; margin-top: 4px; display: block; }
    </style>
</head>
<body>
    <div class="card">
        <h2>➕ Thêm sinh viên mới</h2>
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label>Mã sinh viên (*)</label>
                <input asp-for="StudentCode" placeholder="Ví dụ: B2101234" required />
                <span asp-validation-for="StudentCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Họ và tên (*)</label>
                <input asp-for="FullName" placeholder="Ví dụ: Nguyễn Văn A" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Email (*)</label>
                <input asp-for="Email" type="email" placeholder="Ví dụ: an@educhain.vn" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Lớp học</label>
                <input asp-for="ClassName" placeholder="Ví dụ: CNTT K47" />
            </div>
            <div class="form-group">
                <label>Ngành học</label>
                <input asp-for="Major" placeholder="Ví dụ: Công nghệ thông tin" />
            </div>
            <div class="form-group">
                <label>Địa chỉ ví MetaMask (Tùy chọn)</label>
                <input asp-for="WalletAddress" placeholder="0x..." />
            </div>
            <div class="btn-group">
                <a href="/Student/Index" class="btn btn-secondary">Hủy</a>
                <button type="submit" class="btn btn-primary">Lưu sinh viên</button>
            </div>
        </form>
    </div>
</body>
</html>
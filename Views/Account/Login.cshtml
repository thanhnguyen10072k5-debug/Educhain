@model Educhain.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "EduChain - Đăng Nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduChain | Đăng nhập hệ thống</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Inter', sans-serif;
            background: #0f172a;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .login-card {
            background: #ffffff;
            width: 100%;
            max-width: 440px;
            border-radius: 16px;
            padding: 40px 32px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
        }
        .brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 24px;
        }
        .logo-box {
            width: 46px;
            height: 46px;
            background: linear-gradient(135deg, #2586ff, #6257ed);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }
        .brand h2 { font-size: 24px; font-weight: 800; color: #111c35; }
        .brand span { color: #2586ff; }
        .subtitle {
            text-align: center;
            font-size: 13px;
            color: #64748b;
            margin-bottom: 28px;
        }
        .form-group { margin-bottom: 18px; }
        label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            color: #334155;
        }
        input[type="email"], input[type="password"] {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            font-size: 14px;
            outline: none;
            transition: border-color .2s;
        }
        input[type="email"]:focus, input[type="password"]:focus {
            border-color: #2586ff;
            box-shadow: 0 0 0 3px rgba(37, 134, 255, 0.15);
        }
        .remember-group {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #475569;
            margin-bottom: 22px;
        }
        .btn-submit {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #2586ff, #1d4ed8);
            color: white;
            border: none;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: opacity .2s;
        }
        .btn-submit:hover { opacity: 0.92; }
        .error-message {
            background: #fee2e2;
            color: #dc2626;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
        }
        .demo-accounts {
            margin-top: 24px;
            padding-top: 18px;
            border-top: 1px solid #f1f5f9;
            font-size: 11px;
            color: #64748b;
            line-height: 1.6;
        }
        .demo-accounts code {
            background: #f1f5f9;
            padding: 2px 5px;
            border-radius: 4px;
            color: #0f172a;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand">
            <div class="logo-box">🎓</div>
            <h2>Edu<span>Chain</span></h2>
        </div>
        <p class="subtitle">Đăng nhập cổng thông tin quản lý điểm ứng dụng Blockchain</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-message">
                @Html.ValidationSummary(true, "")
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label>Email đăng nhập</label>
                <input asp-for="Email" type="email" placeholder="ví dụ: admin@educhain.vn" required />
            </div>
            <div class="form-group">
                <label>Mật khẩu</label>
                <input asp-for="Password" type="password" placeholder="••••••••" required />
            </div>
            <div class="remember-group">
                <input asp-for="RememberMe" type="checkbox" id="remember" />
                <label for="remember" style="margin: 0; font-weight: 400; cursor: pointer;">Ghi nhớ đăng nhập</label>
            </div>
            <button type="submit" class="btn-submit">Đăng Nhập</button>
        </form>

        <div class="demo-accounts">
            <strong>Tài khoản thử nghiệm hệ thống:</strong><br>
            • Admin: <code>admin@educhain.vn</code> / <code>Admin@123</code><br>
            • Giảng viên: <code>teacher@educhain.vn</code> / <code>Teacher@123</code><br>
            • Sinh viên: <code>student@educhain.vn</code> / <code>Student@123</code>
        </div>
    </div>
</body>
</html>